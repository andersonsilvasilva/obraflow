# Copie para ".env" (NÃO versionar) e preencha. Nenhum valor real deve ser commitado.

# Aplicação
APP_ENV=production
APP_DEBUG=false
# Gere com: php artisan key:generate --show   (formato base64:...)
APP_KEY=
APP_URL=http://localhost:8080
SANCTUM_STATEFUL_DOMAINS=localhost:8080
FRONTEND_URL=http://localhost:8080
API_TOKEN_MAX_DAYS=90
INVITATION_TTL_DAYS=7
NGINX_PORT=8080

# MySQL
MYSQL_DATABASE=obraflow
MYSQL_USER=obraflow
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Redis
REDIS_PASSWORD=

# Frontend (build)
VITE_API_URL=/api/v1
VITE_USE_MOCKS=true
