APP_NAME=ObraFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL — use um usuário EXCLUSIVO da aplicação (nunca root). Os valores reais ficam só no .env local.
# Banco de testes: obraflow_testing (definido em phpunit.xml).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=obraflow
DB_USERNAME=obraflow_app
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Drivers LOCAIS (Redis adiado). Para adotar o Redis depois, ver documentation/AMBIENTE_LOCAL.md:
#   SESSION_DRIVER=redis  CACHE_STORE=redis  QUEUE_CONNECTION=redis  (+ REDIS_*)
# ---------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Redis (não utilizado enquanto os drivers acima forem locais)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=obraflow-

# Sanctum: origem do frontend (SPA, sessão por cookie)
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# Tokens de API: validade máxima em dias (expiração obrigatória)
API_TOKEN_MAX_DAYS=90

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@obraflow.local"
MAIL_FROM_NAME="${APP_NAME}"

# Object Storage compativel com S3 (futuro)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
